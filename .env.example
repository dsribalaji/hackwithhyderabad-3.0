# Copy to .env and fill in. NEVER commit .env.

# --- Agent's own LLM (OpenAI-compatible endpoint) ---
# Groq free tier: https://console.groq.com (SB provides key)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b

# --- Hindsight memory layer ---
# embedded = in-process daemon (default, no server to run)
# server   = connect to a Hindsight API server at HINDSIGHT_URL
HINDSIGHT_MODE=embedded
HINDSIGHT_URL=http://localhost:8888
# LLM Hindsight itself uses for fact extraction (retain) and reasoning (reflect).
# Options:
#   none     - no LLM. Boots anywhere; recall still works (local embeddings),
#              but fact extraction/consolidation/reflect are degraded.
#   groq     - recommended when you have a key. Fast, free tier. Full extraction.
#   llamacpp - fully local, auto-downloads a ~3.5GB GGUF on first run. No signup.
#              (Needs the local-llm extra: uv pip install llama-cpp-python)
HINDSIGHT_LLM_PROVIDER=none
HINDSIGHT_LLM_MODEL=qwen/qwen3-32b
HINDSIGHT_LLM_API_KEY=

# Demo bank id (each scenario/user gets its own bank)
BANK_ID=shopmind-demo
