# Copy to .env and fill in. NEVER commit .env.

# --- Agent's own LLM (OpenAI-compatible endpoint) ---
# Groq free tier: https://console.groq.com (SB provides key)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3-32b

# --- Hindsight memory layer ---
# embedded = in-process daemon (default, no server to run)
# server   = connect to a Hindsight API server at HINDSIGHT_URL
HINDSIGHT_MODE=embedded
HINDSIGHT_URL=http://localhost:8888
# LLM Hindsight itself uses for fact extraction (retain) and reasoning (reflect).
# llamacpp = fully local, auto-downloads a small GGUF on first run. No signup.
HINDSIGHT_LLM_PROVIDER=llamacpp
HINDSIGHT_LLM_MODEL=
HINDSIGHT_LLM_API_KEY=

# Demo bank id (each scenario/user gets its own bank)
BANK_ID=shopmind-demo
